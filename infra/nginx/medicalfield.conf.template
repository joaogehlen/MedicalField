# MedicalField — API Gateway (Nginx).
# Gerado a partir deste template por infra/scripts/render-nginx.sh:
#   MF_PORT  porta pública (80 na VM, 8080 no desenvolvimento)
#   MF_WWW   pasta com os builds do cliente (app/) e do portal (portal/)

upstream mf_identity { server 127.0.0.1:8081; }   # Java · Spring Boot
upstream mf_clinical { server 127.0.0.1:3001; }   # TypeScript · NestJS
upstream mf_document { server 127.0.0.1:8000; }   # Python · FastAPI

map $http_x_request_id $mf_request_id {
  default $http_x_request_id;
  ""      $request_id;
}

server {
  listen ${MF_PORT};
  server_name _;
  client_max_body_size 5m;

  proxy_http_version 1.1;
  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Request-Id      $mf_request_id;
  proxy_read_timeout 60s;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # identity-service: autenticação, profissionais, logs do dispositivo
  location ~ ^/api/(auth|profissional|log|access-log)(/.*)?$ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://mf_identity;
  }

  # document-service: ficha PDF e e-mail
  location ^~ /api/ficha/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://mf_document;
  }

  # clinical-service: demais rotas da API (sem ^~ para a regex do identity valer antes)
  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass http://mf_clinical;
  }

  # Cliente (PWA) e portal
  location = /app { return 301 /app/; }
  location /app/ {
    alias ${MF_WWW}/app/;
    try_files $uri $uri/ /app/index.html;
  }
  location = /app/sw.js {
    alias ${MF_WWW}/app/sw.js;
    add_header Cache-Control "no-cache";
  }
  location = /portal { return 301 /portal/; }
  location /portal/ {
    alias ${MF_WWW}/portal/;
    try_files $uri $uri/ /portal/index.html;
  }
  location = / { return 302 /portal/; }
}
