{
  "name": "@medicalfield/clinical-service",
  "version": "1.0.0",
  "private": true,
  "description": "Núcleo clínico do MedicalField: pessoas, prontuários, atendimentos, catálogo e sincronização (NestJS).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
