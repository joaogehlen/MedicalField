{
  "info": {
    "name": "MedicalField API",
    "description": "Rotas dos três serviços pelo gateway Nginx. Rode primeiro **Login (CRM)**: o token fica guardado e as outras requisições já usam.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "opId",
      "value": ""
    },
    {
      "key": "pessoaId",
      "value": "2d4f0000-0000-4000-8000-000000000001"
    },
    {
      "key": "prontuarioId",
      "value": "1a6b0000-0000-4000-8000-000000000001"
    },
    {
      "key": "atendimentoId",
      "value": "0f9c0000-0000-4000-8000-000000000001"
    },
    {
      "key": "novaPessoaId",
      "value": ""
    },
    {
      "key": "novoProntuarioId",
      "value": ""
    },
    {
      "key": "novoAtendimentoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "identity-service (Java)",
      "item": [
        {
          "name": "Login (CRM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "Única rota pública.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoRegistro\": \"CRM\",\n  \"numeroRegistro\": \"12345\",\n  \"uf\": \"RS\",\n  \"senha\": \"medicalfield\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.accessToken);",
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (ADMIN — central)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoRegistro\": \"SOCORRISTA\",\n  \"numeroRegistro\": \"0001\",\n  \"uf\": null,\n  \"senha\": \"medicalfield\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.accessToken);",
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sem token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/medicamento",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "medicamento"
              ],
              "query": []
            },
            "description": "Toda rota, exceto o login, exige token.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Profissionais",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/profissional",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "profissional"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Enviar logs do aparelho",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/log",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "log"
              ],
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dispositivoId\": \"postman\",\n  \"logs\": [\n    {\n      \"id\": \"{{$guid}}\",\n      \"dataHora\": \"{{$isoTimestamp}}\",\n      \"profissionalId\": \"7a1f0000-0000-4000-8000-000000000002\",\n      \"acao\": \"TESTE_POSTMAN\",\n      \"detalhes\": {\n        \"origem\": \"postman\"\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
