        {
          "name": "Atendimentos de uma pessoa",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/atendimento/{{pessoaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "atendimento",
                "{{pessoaId}}"
              ],
              "query": []
            },
            "description": "Na proposta, {id} é o id da pessoa."
          }
        },
        {
          "name": "Atendimento (detalhe)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/atendimento/detalhe/{{atendimentoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "atendimento",
                "detalhe",
                "{{atendimentoId}}"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Cadastrar pessoa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{opId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pessoa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pessoa"
              ],
              "query": []
            },
            "description": "Reenvie com a mesma Idempotency-Key: a resposta é a mesma e nada é duplicado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{novaPessoaId}}\",\n  \"nome\": \"Paciente Postman\",\n  \"cpf\": null,\n  \"dataNascimento\": \"1990-01-15\",\n  \"sexo\": \"F\",\n  \"telefone\": null,\n  \"email\": null,\n  \"contatoNome\": \"Familiar\",\n  \"contatoEmail\": \"familiar@exemplo.com.br\",\n  \"atualizadoEmCliente\": \"{{$isoTimestamp}}\",\n  \"registradoPor\": \"7a1f0000-0000-4000-8000-000000000002\",\n  \"dispositivoId\": \"postman\",\n  \"criadoOffline\": false,\n  \"baseVersion\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('opId', pm.variables.replaceIn('{{$guid}}'));",
                  "if (!pm.collectionVariables.get('novaPessoaId')) pm.collectionVariables.set('novaPessoaId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 ou 200', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar prontuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
