            "description": "Troque a dose para 20 e veja o 422 REGRA_CLINICA (dose acima da máxima).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{novoAtendimentoId}}\",\n  \"pessoaId\": \"{{novaPessoaId}}\",\n  \"prontuarioId\": \"{{novoProntuarioId}}\",\n  \"dataHora\": \"{{$isoTimestamp}}\",\n  \"local\": \"Av. Avelino Talini, 171 — Lajeado\",\n  \"queixaPrincipal\": \"Dispneia\",\n  \"observacoes\": null,\n  \"triagem\": {\n    \"protocolo\": \"MANCHESTER\",\n    \"classificacao\": \"AMARELO\"\n  },\n  \"glasgow\": {\n    \"ocular\": 4,\n    \"verbal\": 5,\n    \"motora\": 6,\n    \"total\": 15\n  },\n  \"sinaisVitais\": {\n    \"paSistolica\": 130,\n    \"paDiastolica\": 85,\n    \"fc\": 96,\n    \"fr\": 22,\n    \"spo2\": 93,\n    \"temperatura\": 36.8,\n    \"glicemia\": null\n  },\n  \"medicamentos\": [\n    {\n      \"id\": \"{{$guid}}\",\n      \"medicamentoId\": \"5e3d0000-0000-4000-8000-000000000004\",\n      \"dose\": 4,\n      \"via\": \"IV\",\n      \"horario\": \"{{$isoTimestamp}}\"\n    }\n  ],\n  \"profissionalNome\": \"Dra. Ana Souza · CRM 12345/RS\",\n  \"atualizadoEmCliente\": \"{{$isoTimestamp}}\",\n  \"registradoPor\": \"7a1f0000-0000-4000-8000-000000000002\",\n  \"dispositivoId\": \"postman\",\n  \"criadoOffline\": false,\n  \"baseVersion\": null\n}",
