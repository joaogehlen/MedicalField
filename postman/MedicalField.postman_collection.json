{
  "info": {
    "name": "MedicalField",
    "description": "API do MedicalField pelo gateway Nginx. Rode 'Autenticação > Login' primeiro: o token fica em {{token}}. Demonstração de idempotência: repita 'Cadastrar atendimento' com a mesma Idempotency-Key fixa.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "profissionalId",
      "value": ""
    },
    {
      "key": "pessoaId",
      "value": "2d4f0000-0000-4000-8000-000000000001"
    },
    {
      "key": "prontuarioId",
      "value": "1a6b0000-0000-4000-8000-000000000001"
    },
    {
      "key": "atendimentoId",
      "value": "0f9c0000-0000-4000-8000-000000000001"
    }
  ],
  "item": [
    {
      "name": "Autenticação (identity · Java)",
      "item": [
        {
          "name": "Login (CRM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "Única rota pública.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoRegistro\": \"CRM\",\n  \"numeroRegistro\": \"12345\",\n  \"uf\": \"RS\",\n  \"senha\": \"medicalfield\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.accessToken);",
                  "pm.collectionVariables.set('refreshToken', r.refreshToken);",
                  "pm.collectionVariables.set('profissionalId', r.profissional.id);",
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (ADMIN — regulação)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "Necessário para rotas de auditoria e /profissional.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoRegistro\": \"SOCORRISTA\",\n  \"numeroRegistro\": \"0001\",\n  \"senha\": \"medicalfield\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.accessToken);",
                  "pm.collectionVariables.set('refreshToken', r.refreshToken);",
                  "pm.collectionVariables.set('profissionalId', r.profissional.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ],
              "query": []
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('token', r.accessToken);",
                  "pm.collectionVariables.set('refreshToken', r.refreshToken);"
                ]
              }
            }
          ]
        },
