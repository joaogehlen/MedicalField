            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{pessoaId}}\",\n  \"nome\": \"Vítima Postman\",\n  \"identificada\": false,\n  \"caracteristicas\": \"Homem, ~40 anos, camiseta azul\",\n  \"atualizadoEmCliente\": \"{{agora}}\",\n  \"registradoPor\": \"{{profissionalId}}\",\n  \"dispositivoId\": \"postman\",\n  \"baseVersion\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('agora', new Date().toISOString());",
                  "pm.variables.set('novoId', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('pessoaId', pm.variables.get('novoId'));"
                ]
              }
            }
          ]
        },
